# ======================================
# AI Hotspot Daily Report Configuration
# ======================================

# Required API Keys
# -----------------

# Anthropic Claude API Key (Required for AI analysis)
# Get from: https://console.anthropic.com
# Cost: ~$0.01-0.05 per report
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ModelScope API Key (Required for image generation)
# Get from: https://modelscope.cn → Profile → API Tokens
# Cost: Free tier available, ~¥0.01-0.05 per image
MODELSCOPE_API_KEY=your-modelscope-token-here

# Optional Configuration
# ---------------------

# Obsidian Vault Path (Optional, will auto-detect if not set)
# Example: /Users/yourusername/Documents/Obsidian Vault/AI-Hotspots/Daily
# OBSIDIAN_VAULT_PATH=

# Proxy Settings (Optional, if behind firewall)
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080
